{
  "name": "@jahia/jahia-cloud-threads-heap-dumps-provider",
  "version": "2.0.4-SNAPSHOT",
  "scripts": {
    "build": "yarn webpack",
    "webpack": "webpack",
    "build:production": "yarn build --mode=production",
    "watch": "yarn webpack --watch",
    "clean": "rimraf *.log src/main/resources/javascript/apps",
    "clean:all": "yarn clean && rimraf node_modules node",
    "lint:js": "eslint --ext js,jsx src/javascript",
    "lint:js:fix": "yarn lint:js --fix",
    "lint": "yarn lint:js",
    "lint:fix": "yarn lint:js:fix",
    "test": "jest",
    "sync-pom": "sync-pom-version --use-yarn"
  },
  "description": "React admin UI for Jahia Cloud Threads and Heap Dumps Provider",
  "main": "index.js",
  "author": "Jahia Customer Support Team <support@jahia.com>",
  "license": "MIT",
  "jahia": {
    "remotes": {
      "jahia": "javascript/apps/remoteEntry.js"
    }
  },
  "dependencies": {
    "@apollo/client": "^3.8.2",
    "@jahia/moonstone": "^2.21.1",
    "@jahia/ui-extender": "^1.1.0",
    "graphql": "^15.10.3",
    "i18next": "^21.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^11.18.6"
  },
  "resolutions": {
    "**/@jest/reporters/glob": "^14.0.3",
    "**/@types/minimatch/minimatch": "^11.0.1",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.1",
    "**/cacache/glob": "^14.0.4",
    "**/jest-config/glob": "^14.0.3",
    "**/jest-runtime/glob": "^14.0.3",
    "**/test-exclude/glob": "^14.0.3",
    "**/test-exclude/minimatch": "^11.0.1",
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "baseline-browser-mapping": "^2.11.22",
    "browserslist": "^4.28.9",
    "fast-uri": "^3.1.9",
    "immutable": "^5.1.9",
    "internal-slot": "^1.1.0",
    "ip-address": "^10.7.6",
    "js-yaml": "^4.3.2",
    "normalize-package-data": "^7.0.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.3",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.22"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "rootDir": "src/javascript",
    "moduleNameMapper": {
      "\\.(scss|css)$": "identity-obj-proxy"
    },
    "transform": {
      "^.+\\.(js|jsx)$": [
        "babel-jest",
        {
          "configFile": false,
          "babelrc": false,
          "presets": [
            "@babel/preset-env",
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@cyclonedx/webpack-plugin": "^5.3.3",
    "@jahia/eslint-config": "2.2.0",
    "@jahia/webpack-config": "^1.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.4.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "rimraf": "^6.1.4",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "sync-pom-version-to-package": "^1.6.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.1",
    "webpack-cli": "^7.3.1"
  }
}
